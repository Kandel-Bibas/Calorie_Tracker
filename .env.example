# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for Drizzle migrations + integration tests
DATABASE_URL=

# AI
GEMINI_API_KEY=
OPENAI_API_KEY=

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# AI meal-analysis rate limits (optional — defaults shown). Protect the shared
# Gemini/Whisper key once the app is public. Per /api/analyze:
#   ANALYZE_RL_USER_HOUR   max AI meal logs per user per hour   (default 10)
#   ANALYZE_RL_USER_DAY    max AI meal logs per user per day    (default 30)
#   ANALYZE_RL_GLOBAL_DAY  max AI meal logs across all users/day (default 500)
ANALYZE_RL_USER_HOUR=10
ANALYZE_RL_USER_DAY=30
ANALYZE_RL_GLOBAL_DAY=500
